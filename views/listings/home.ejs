<% layout("/layouts/boilerplate")%>
<body>
          <div class="home-hero">
  <div class="hero-bg">
    <div class="hero-overlay"></div>
    <img src="https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=1600&auto=format&fit=crop" alt="hero" class="hero-bg-img">
  </div>

  <div class="hero-content">
    <span class="hero-tag">Find your perfect escape</span>
    <h1 class="hero-title">
      Not sure where to go?<br>
      <span class="hero-highlight">Perfect.</span>
    </h1>
    <p class="hero-subtitle">
      Discover handpicked stays — from mountain hideaways to coastal villas — curated for every kind of wanderer.
    </p>
    <a href="/listings" class="hero-btn">
      <span>Explore All Listings</span>
      <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>

  <div class="hero-scroll-hint">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</div>


<!-- Categories Strip -->
<section class="categories-section">
  <div class="categories-grid">
    <div class="cat-item">
      <span class="cat-icon"><i class="fa-solid fa-mountain-sun"></i></span>
      <span class="cat-label">Mountains</span>
    </div>
    <div class="cat-item">
      <span class="cat-icon"><i class="fa-solid fa-water"></i></span>
      <span class="cat-label">Beaches</span>
    </div>
    <div class="cat-item">
      <span class="cat-icon"><i class="fa-solid fa-tree"></i></span>
      <span class="cat-label">Forests</span>
    </div>
    <div class="cat-item">
      <span class="cat-icon"><i class="fa-solid fa-city"></i></span>
      <span class="cat-label">Cities</span>
    </div>
    <div class="cat-item">
      <span class="cat-icon"><i class="fa-solid fa-person-hiking"></i></span>
      <span class="cat-label">Adventures</span>
    </div>
    <div class="cat-item">
      <span class="cat-icon"><i class="fa-solid fa-umbrella-beach"></i></span>
      <span class="cat-label">Tropical</span>
    </div>
  </div>
</section>


<!-- Why WanderLust Section -->
<section class="why-section">
  <div class="why-text">
    <p class="why-tag">Why WanderLust</p>
    <h2 class="why-title">Travel should feel<br><em>effortless</em></h2>
    <p class="why-desc">
      We believe every journey starts with finding the right place to stay. WanderLust connects you to unique homes, retreats, and getaways — no noise, just the perfect stay.
    </p>
    <a href="/listings" class="why-link">
      Browse Listings <i class="fa-solid fa-chevron-right"></i>
    </a>
  </div>
  <div class="why-stats">
    <div class="stat-card">
      <span class="stat-number">500+</span>
      <span class="stat-label">Unique Properties</span>
    </div>
    <div class="stat-card">
      <span class="stat-number">40+</span>
      <span class="stat-label">Countries</span>
    </div>
    <div class="stat-card">
      <span class="stat-number">10k+</span>
      <span class="stat-label">Happy Guests</span>
    </div>
    <div class="stat-card">
      <span class="stat-number">4.9★</span>
      <span class="stat-label">Avg. Rating</span>
    </div>
  </div>
</section>


<!-- CTA Banner -->
<section class="cta-section">
  <div class="cta-inner">
    <h2 class="cta-title">Have a place to share?</h2>
    <p class="cta-desc">List your property on WanderLust and reach thousands of travellers looking for their next escape.</p>
    <a href="/listings/new" class="cta-btn">
      <i class="fa-solid fa-plus"></i> Add Your Listing
    </a>
  </div>
</section>
</body>
